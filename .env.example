# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/ott-app
MONGODB_USER=ott_user
MONGODB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# API Keys for Services
JIOTV_API_KEY=your_jiotv_api_key
AIRTEL_API_KEY=your_airtel_api_key
TATAPLAY_API_KEY=your_tataplay_api_key

# Service URLs
JIOTV_BASE_URL=https://api.jiotv.com
AIRTEL_BASE_URL=https://api.airtelxtream.com
TATAPLAY_BASE_URL=https://api.tataplay.com

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Video Streaming
HLS_PLAYER_URL=https://cdn.example.com/videos
